# --- Outbound T+0 (llamadas Retell desde Localizados) ---
RETELL_API_KEY=
RETELL_OUTBOUND_AGENT_ID=agent_b8abf941c156192b1995f36c5d
RETELL_FROM_NUMBER=+34871075112
# Si está vacío, hereda NURTURING_PHASE3_ENABLED. Pon true para forzar llamadas
# aunque Phase 3 nurturing esté off, o false para silenciar el CRON.
OUTBOUND_CALLS_ENABLED=
NURTURING_PHASE3_ENABLED=
# Cupo diario de llamadas (default 30). Horario Madrid: L-V 10:00-14:00 y 17:00-20:30.
MAX_DAILY_CALLS=30

# Sync manual review (columna J "Anuncio Revisado?" = SI) → WordPress estate_property
# Única vía activa para crear/actualizar propiedades desde Sheets (sync 30 min desactivado).
REVIEWED_ANUNCIO_WP_SYNC_ENABLED=true
WP_REVIEWED_POST_STATUS=pending
# Valor escrito en "Publicado Popalicer?" tras publicar: SI | PUBLICADO | Si
WP_PUBLISHED_SHEET_VALUE=SI

# --- Meta (Fase 4: Facebook Messenger / Instagram DM) ---
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
# Auto-reply Localisto en Messenger/IG. Dejar false/vacío: GHL gestiona el inbox.
# Nurturing WhatsApp (T+0/T+7) NO depende de esto (usa Twilio).
META_INBOUND_AUTO_REPLY=false

# --- X / Twitter DM (stub futuro) ---
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=
