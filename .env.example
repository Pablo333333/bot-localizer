# --- Outbound T+0 (llamadas Retell desde Localizados) ---
RETELL_API_KEY=
RETELL_OUTBOUND_AGENT_ID=agent_b8abf941c156192b1995f36c5d
RETELL_FROM_NUMBER=+34871075112
# Si está vacío, hereda NURTURING_PHASE3_ENABLED. Pon true para forzar llamadas
# aunque Phase 3 nurturing esté off, o false para silenciar el CRON.
OUTBOUND_CALLS_ENABLED=
NURTURING_PHASE3_ENABLED=
# Cupo diario de llamadas (default 30). Horario Madrid: L-V 10:00-14:00 y 17:00-20:30.
MAX_DAILY_CALLS=30
# Prueba Toni: si está definido, SOLO se llama a ese número (ej. +34644408099). Vacío = todas las filas.
OUTBOUND_TEST_PHONE_ONLY=

# Sync manual review (columna J "Anuncio Revisado?" = SI) → WordPress estate_property
# Única vía activa para crear/actualizar propiedades desde Sheets (sync 30 min desactivado).
REVIEWED_ANUNCIO_WP_SYNC_ENABLED=true
WP_REVIEWED_POST_STATUS=pending

# Nurturing Fase 3 (WA T+0 + enroll T+7/T+10). Debe ser true en Railway para Toni.
NURTURING_PHASE3_ENABLED=true
# Canal T+0 mientras no haya plantilla WA aprobada: whatsapp | sms | both
NURTURING_T0_CHANNEL=sms
# SMS Twilio (T+0 prueba / T+7)
TWILIO_SMS_FROM=

# --- Meta (Fase 4: Facebook Messenger / Instagram DM) ---
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
# Auto-reply Localisto en Messenger/IG. Dejar false/vacío: GHL gestiona el inbox.
# Nurturing WhatsApp (T+0/T+7) NO depende de esto (usa Twilio).
META_INBOUND_AUTO_REPLY=false

# --- X / Twitter Direct Messages (solo DMs; no tweets ni menciones) ---
# Credenciales OAuth 1.0a (User Context). Alias legacy: X_CONSUMER_* / X_ACCESS_TOKEN_SECRET
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Retell Chat Agent (prompt de texto Localisto, independiente del agente de voz)
X_AGENT_ID=
# User ID numérico de la cuenta del bot (anti-bucle / filtrar ecos)
X_BOT_USER_ID=
# Auto-reply: true|false. Vacío = true si hay X_AGENT_ID
X_INBOUND_AUTO_REPLY=
# v2 (default) = POST /2/dm_conversations/with/:id/messages | v1.1 = events/new
X_DM_API_VERSION=v2
# También se aceptan: X_CONSUMER_KEY, X_CONSUMER_SECRET, X_ACCESS_TOKEN_SECRET, X_BEARER_TOKEN
X_BEARER_TOKEN=
