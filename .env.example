# --- Outbound Fase 1 (lote diario Localizados → Retell → Sheets → WP) ---
RETELL_API_KEY=
RETELL_OUTBOUND_AGENT_ID=agent_b8abf941c156192b1995f36c5d
RETELL_FROM_NUMBER=+34871075112
# Lote automático PAUSADO en código (OUTBOUND_AUTO_DIAL_PAUSED=true).
# En Railway dejar también false para no reactivar por env:
OUTBOUND_CALLS_ENABLED=false
NURTURING_PHASE3_ENABLED=false
MAX_DAILY_CALLS=30
# Vacío = siguientes 30 pendientes del Sheet (Llamado≠SI). NO poner número Toni en lote masivo.
OUTBOUND_TEST_PHONE_ONLY=
# Horario automático: L-V 10:00-14:00 y 17:00-20:30 Europe/Madrid (CRON cada 5 min).
# Si OUTBOUND_CALLS_ENABLED vacío, hereda NURTURING_PHASE3_ENABLED (compat).

# Sync manual review (columna J "Anuncio Revisado?" = SI) → WordPress estate_property
# Única vía activa para crear/actualizar propiedades desde Sheets (sync 30 min desactivado).
REVIEWED_ANUNCIO_WP_SYNC_ENABLED=true
WP_REVIEWED_POST_STATUS=pending

# --- Fase 3 nurturing (PAUSADA en lote masivo; solo pruebas manuales Toni) ---
# true solo cuando Toni pruebe WA/enroll T+7/T+10 a mano.
# NURTURING_PHASE3_ENABLED=false  (ya arriba)
# Canal T+0 mientras no haya plantilla WA: whatsapp | sms | both
NURTURING_T0_CHANNEL=sms
TWILIO_SMS_FROM=

# --- Meta (Fase 4: Facebook Messenger / Instagram DM) ---
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
# Auto-reply Localisto en Messenger/IG. Dejar false/vacío: GHL gestiona el inbox.
# Nurturing WhatsApp (T+0/T+7) NO depende de esto (usa Twilio).
META_INBOUND_AUTO_REPLY=false

# --- X / Twitter Direct Messages (solo DMs; no tweets ni menciones) ---
# Credenciales OAuth 1.0a (User Context). Alias legacy: X_CONSUMER_* / X_ACCESS_TOKEN_SECRET
X_API_KEY=
# Consumer Secret — obligatorio para CRC GET /x/webhook?crc_token=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Opcional: Retell Chat Agent (si vacío → OpenAI + prompt provisional)
X_AGENT_ID=
# Prompt provisional (hasta Sheets/DB). Multilínea vía \n. Vacío = fallback genérico en código.
X_DM_SYSTEM_PROMPT=
# local = forzar OpenAI | vacío = Retell si hay X_AGENT_ID
X_DM_ENGINE=
X_DM_OPENAI_MODEL=gpt-4o
# User ID numérico de la cuenta del bot (anti-bucle / filtrar ecos)
X_BOT_USER_ID=
# Auto-reply: true|false. Vacío = true si hay X_AGENT_ID o OPENAI_API_KEY
X_INBOUND_AUTO_REPLY=true
# v2 (default) = POST /2/dm_conversations/with/:id/messages | v1.1 = events/new
X_DM_API_VERSION=v2
X_BEARER_TOKEN=
# Webhook: https://<host>/x/webhook | Auditar prompt: GET /x/prompt
