# --- Outbound Fase 1 (lote diario Localizados → Retell → Sheets → WP) ---
# true = pausa llamadas Retell automáticas + WhatsApp automático (emergencia / infra).
# Webhooks, sync Sheets/WP y APIs manuales siguen activos. Poner false al reactivar.
PAUSE_ALL_AUTOMATIONS=true
RETELL_API_KEY=
RETELL_OUTBOUND_AGENT_ID=agent_b8abf941c156192b1995f36c5d
RETELL_INBOUND_AGENT_ID=agent_0f4976dcf81fabf8d95fce33e1
# URL pública que Retell llama al ejecutar AGENDAR_LLAMADA.
PUBLIC_BASE_URL=https://bot-localicer-production.up.railway.app
# Secreto obligatorio para POST /webhooks/retell y /webhooks/retell/agendar-llamada.
# Cabeceras: x-localicer-tool-key | x-retell-webhook-secret | x-api-key | Bearer.
# Configúralo también en el dashboard de Retell (custom header del webhook).
RETELL_WEBHOOK_SECRET=
# Alias compat (si RETELL_WEBHOOK_SECRET vacío se usa este).
RETELL_TOOL_SECRET=
GOOGLE_CALENDAR_ID=
RETELL_FROM_NUMBER=+34871075112
# Lote Fase 1 producción: 35 llamadas/día, L-V 10:00-14:00 y 17:00-20:30 Madrid.
# Fase 3: master ON. Allowlist: vacío=solo Toni; *=todos los anunciantes.
# Prueba en vivo: true comprime T+7 y T+10 a minutos. En producción: false.
NURTURING_FAST_TEST=false
NURTURING_FAST_T7_MINUTES=3
NURTURING_FAST_T10_MINUTES=5
OUTBOUND_CALLS_ENABLED=true
NURTURING_PHASE3_ENABLED=true
# Vacío = solo +34644408099 (Toni). * | ALL = anunciantes reales.
NURTURING_PHASE3_PHONE_ALLOWLIST=*
MAX_DAILY_CALLS=35
# Cupo diario independiente Fase 3 (backfill Localizados no contactados → SequenceEnrollment).
# No consume el cupo del marcador Fase 1. Default 30.
MAX_DAILY_PHASE3_LEADS=30
# Espaciado orgánico entre llamadas (ms). Default 5–10 min — evita ráfagas / antispam.
OUTBOUND_DELAY_MIN_MS=300000
OUTBOUND_DELAY_MAX_MS=600000
# Vacío = números reales del Sheet (Fase 1 completa).
# Sandbox: false en producción. true = solo Toni (+34644408099)
# en llamadas Retell y en el sync Reviewed→WP (el resto de SI se omite).
OUTBOUND_SANDBOX_WHITELIST_ENABLED=false
OUTBOUND_TEST_PHONE_ONLY=
# Horario automático: L-V 10:00-14:00 y 17:00-20:30 Europe/Madrid (CRON cada 5 min; máx. 1 llamada/ciclo).
# Si OUTBOUND_CALLS_ENABLED vacío, hereda NURTURING_PHASE3_ENABLED (compat).

# Sync a WordPress cuando "Publicación Autorizada?" = SI (por nombre de cabecera).
# Llamadas outbound: "Anuncio Revisado?" = SI. Única vía activa Sheets → estate_property.
REVIEWED_ANUNCIO_WP_SYNC_ENABLED=true
WP_REVIEWED_POST_STATUS=pending
# true (default): no sobrescribir estate_property ya publicados salvo "Forzar sync WP"=SI o ?force=1
WP_SYNC_PROTECT_PUBLISHED=true
# Carpeta raíz de fotos en Google Drive (fallback por Call ID / ID_WP / subcarpeta).
# Preferible: columna Sheet "Carpeta Drive" o "URL imagen" por fila.
# Si el enlace lleva ?resourcekey=, hace falta DRIVE_ROOT_RESOURCE_KEY y compartir
# la carpeta con la cuenta de servicio (si no, Drive responde "File not found").
DRIVE_ROOT_FOLDER_ID=
DRIVE_ROOT_RESOURCE_KEY=

# --- Fase 3 nurturing ---
# NURTURING_PHASE3_ENABLED=true + NURTURING_PHASE3_PHONE_ALLOWLIST=* para producción.
# NURTURING_FAST_TEST=false → T+7 = 7 días, T+10 = 10 días.
# Secuencia Toni fija en código (no la cambia el canal):
# Llamada 1 cuelgue → WhatsApp con enlace + programa llamada 2
# Llamada 2 cuelgue → SMS de respaldo + programa llamada 3
# Llamada 3 no contesta → ILOCALIZABLE
# NURTURING_WHATSAPP_ENABLED=false solo bloquea otros envíos; la llamada 1 igual intenta WhatsApp.
NURTURING_T0_CHANNEL=whatsapp
NURTURING_WHATSAPP_ENABLED=true
# Content SID Twilio SMS seguimiento ({{1}}=título inmueble; enlace en la plantilla). Vacío = body libre.
TWILIO_SMS_CONTENT_SID=HX623b40271b0f7fab6282f6548e0ba487
# WhatsApp aprobado: seguimiento_fase_3_2. {{1}}=título. wa.me/34644408099 va fijo en la plantilla.
# Vacío = body libre. Si no se define, el backend usa HXb5f288b5cb78c4cb9d001ad5be46412e.
# TWILIO_WHATSAPP_CONTENT_SID=HXb5f288b5cb78c4cb9d001ad5be46412e
# Opcional: solo fallback si el payload no trae contentVariables (el follow-up
# las rellena siempre desde Lead: {{1}}=título del inmueble).
# TWILIO_SMS_CONTENT_VARIABLES=
# Remitente SMS (si vacío, se deriva de TWILIO_WHATSAPP_NUMBER sin prefijo whatsapp:)
TWILIO_SMS_FROM=

# --- Meta (Fase 4: Facebook Messenger / Instagram DM) ---
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
# Auto-reply Localisto en Messenger/IG. Dejar false/vacío: GHL gestiona el inbox.
# Nurturing WhatsApp (T+0/T+7) NO depende de esto (usa Twilio).
META_INBOUND_AUTO_REPLY=false

# --- X / Twitter Direct Messages (solo DMs; no tweets ni menciones) ---
# Credenciales OAuth 1.0a (User Context). Alias legacy: X_CONSUMER_* / X_ACCESS_TOKEN_SECRET
X_API_KEY=
# Consumer Secret — obligatorio para CRC GET /x/webhook?crc_token=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Opcional: Retell Chat Agent (si vacío → OpenAI + prompt provisional)
X_AGENT_ID=
# Legacy opcional. Preferible editar la pestaña Config_X celda B2 en Google Sheets.
X_DM_SYSTEM_PROMPT=
# local = forzar OpenAI | vacío = Retell si hay X_AGENT_ID
X_DM_ENGINE=
X_DM_OPENAI_MODEL=gpt-4o
# User ID numérico de la cuenta del BOT (anti-bucle). Si falta, se toma de
# for_user_id del webhook o del prefijo de X_ACCESS_TOKEN (`123-xxxx` → 123).
# NO pongas aquí el ID de la cuenta de prueba que escribe el DM.
X_BOT_USER_ID=
# Auto-reply: true|false. Vacío = true si hay X_AGENT_ID o OPENAI_API_KEY
X_INBOUND_AUTO_REPLY=true
# v2 (default) = POST /2/dm_conversations/with/:id/messages | v1.1 = events/new
X_DM_API_VERSION=v2
X_BEARER_TOKEN=
# Webhook: https://<host>/x/webhook | Auditar prompt: GET /x/prompt (Sheets Config_X!B2)
